<Project>
  <PropertyGroup>
    <OutputPath Condition="'$(UseDefaultOutputPath)' != 'true'">$(MSBuildThisFileDirectory)..\Binaries\Managed\</OutputPath>
  </PropertyGroup>

  <!-- Remove duplicate analyzers -->
  <Target Name="UnrealSharpRemoveDuplicateAnalyzers" BeforeTargets="CoreCompile">
    <RemoveDuplicates Inputs="@(Analyzer->'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_UnrealSharpUniqueAnalyzer" />
    </RemoveDuplicates>
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" />
      <Analyzer Include="@(_UnrealSharpUniqueAnalyzer)" />
    </ItemGroup>
  </Target>
</Project>
